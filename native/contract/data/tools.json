  {
    "name": "export_mini_program",
    "description": "提交一个任意小程序包导出任务（异步，立即返回 task_id，不会阻塞 agent）。\n通过本地授权会话从远程服务按 appid 或 username 下载完整 wxapkg；提交后用 export_status 查询进度与最终结果。\nversion_type: 0 正式(默认)、1 体验、2 开发、999 预览；version 为空取最新。",
    "inputSchema": {
      "type": "object",
      "title": "参数",
      "properties": {
        "appid": {
          "type": "string",
          "default": "",
          "title": "AppID",
          "description": "目标 AppID"
        },
        "username": {
          "type": "string",
          "default": "",
          "title": "用户名",
